{
  "name": "@sentinel/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3000",
    "dev:next": "next dev --port 3000",
    "build": "vinext build",
    "build:staging": "node scripts/cloudflare-build.mjs staging build",
    "build:production": "node scripts/cloudflare-build.mjs production build",
    "build:next": "next build",
    "deploy:staging": "node scripts/cloudflare-build.mjs staging deploy",
    "deploy:production": "node scripts/cloudflare-build.mjs production deploy",
    "preview": "vinext build && vite preview --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "next": "^16.3.3",
    "qrcode.react": "4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "^1.54.3",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^7.0.2",
    "vinext": "1.0.0-beta.9",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
