{
  "name": "@sentinel/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 3000",
    "dev:next": "next dev --port 3000",
    "build": "vinext build",
    "build:next": "next build",
    "deploy": "vinext build && wrangler deploy",
    "preview": "vinext build && vite preview --port 3000",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "next": "^16.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^5.9.2",
    "vinext": "1.0.0-beta.8",
    "vite": "^8.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.68.0"
  }
}
