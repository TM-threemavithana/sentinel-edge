{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-edge-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "EDGE_COORDINATOR",
        "class_name": "EdgeCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EdgeCoordinator"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "sentinel-edge-gateway-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
        "AI_MODE": "async",
        "SESSION_COOKIE": "sentinel_session_staging",
        "SESSION_TTL_SECONDS": "28800",
        "MAX_INSPECTION_BYTES": "1048576",
        "FREE_TIER_MODE": "true",
        "ALLOWED_ORIGINS": "https://sentinel-edge-console-staging.tharukamaduwantha62.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sentinel-edge-db-staging",
          "database_id": "STAGING_DB_ID_PLACEHOLDER",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "POLICY_CACHE",
          "id": "STAGING_KV_ID_PLACEHOLDER"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "name": "sentinel-edge-gateway-production",
      "vars": {
        "ENVIRONMENT": "production",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
        "AI_MODE": "async",
        "SESSION_COOKIE": "sentinel_session",
        "SESSION_TTL_SECONDS": "28800",
        "MAX_INSPECTION_BYTES": "1048576",
        "FREE_TIER_MODE": "true",
        "ALLOWED_ORIGINS": "https://sentinel-edge-console.tharukamaduwantha62.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sentinel-edge-db",
          "database_id": "dd113ba0-d8a6-4195-bf77-d9eb03157516",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "POLICY_CACHE",
          "id": "e3cd15f9002945af98fc200fa8c7de7e"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}\n