# Public origin of the gateway Worker when the web app runs outside Cloudflare.
GATEWAY_ORIGIN=http://localhost:8787
NEXT_PUBLIC_APP_NAME=Sentinel Edge

# Copy apps/gateway/.dev.vars.example to apps/gateway/.dev.vars for local secrets.

# Cloudflare Access identity enforcement for deployed management routes.
ACCESS_REQUIRED=false
# Required when ACCESS_REQUIRED=true:
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience

# Free app-managed TOTP MFA. Deployed environments must enforce this or Access.
MFA_REQUIRED=true
