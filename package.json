{
  "name": "sentinel-edge",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style AI and API security gateway for Cloudflare",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @sentinel/security-core build && pnpm --filter @sentinel/gateway build && pnpm --filter @sentinel/web build",
    "dev": "pnpm --parallel --filter @sentinel/gateway --filter @sentinel/web dev",
    "dev:gateway": "pnpm --filter @sentinel/gateway dev",
    "dev:web": "pnpm --filter @sentinel/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm --filter @sentinel/security-core test:coverage && pnpm --filter @sentinel/gateway test:coverage",
    "cf:typegen": "pnpm --filter @sentinel/gateway cf:typegen && pnpm --filter @sentinel/web cf:typegen"
  }
}
